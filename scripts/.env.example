# Meta WhatsApp Cloud API — https://developers.facebook.com/apps/
# System User token with whatsapp_business_messaging permission (recommended: permanent token)
WHATSAPP_ACCESS_TOKEN=

# Phone Number ID (not the display number) — WhatsApp > API Setup in Meta app
WHATSAPP_PHONE_NUMBER_ID=

# Template: wedding_talia_avner · English in Manager → API must use en (NOT he)
WHATSAPP_TEMPLATE_NAME=wedding_talia_avner
WHATSAPP_TEMPLATE_LANGUAGE=en

# Path to guest Excel (name, phone, invitation link)
GUEST_EXCEL_PATH=C:\Users\איתי\OneDrive\שולחן העבודה\מוזמנים-ממתינים-חתונה-2026-06-02 (1).xlsx

# For --test: send one message to this number (Israeli 05... or 972...)
WHATSAPP_TEST_TO=

# If the template header image is dynamic, public HTTPS URL to the image
# WHATSAPP_HEADER_IMAGE_URL=

# If the "עדכון הגעה" button URL ends with {{1}}, set suffix from invitation link (default: on)
# WHATSAPP_BUTTON_URL_SUFFIX_FROM_LINK=true

# Template button is .../i/fCdvMYab4H16{{1}} — script strips this before sending {{1}}
WHATSAPP_BUTTON_STRIP_PREFIX=fCdvMYab4H16
